<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tag Receptacles" Width="480" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" Background="#F7F7F7">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="7,5"/>
            <Setter Property="Margin" Value="0,5,0,0"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="MinWidth" Value="90"/>
            <Setter Property="Padding" Value="12,6"/>
        </Style>
    </Window.Resources>
    <StackPanel Margin="24">
        <TextBlock Text="Tag Receptacles" FontSize="22" FontWeight="SemiBold"/>
        <TextBlock Margin="0,8,0,18" TextWrapping="Wrap"
                   Text="Tag untagged receptacles on the active floor plan, or eligible plans on the active sheet. Existing tags are kept."/>

        <TextBlock Text="Tag Family"/>
        <TextBlock Text="FFE_Tag_EF_Receptacle" FontWeight="SemiBold" Margin="0,5,0,0"/>
        <TextBlock Margin="0,5,0,18" Foreground="#555555" TextWrapping="Wrap"
                   Text="Left/right text alignment (LA/RA) is selected automatically to match the leader attachment side. Both families must be loaded with all four tag types."/>

        <TextBlock Text="Mode"/>
        <StackPanel Orientation="Horizontal" Margin="0,8,0,6">
            <RadioButton x:Name="writeMode" Content="Write" GroupName="Mode" Margin="0,0,24,0"/>
            <RadioButton x:Name="previewMode" Content="Preview" GroupName="Mode"/>
        </StackPanel>
        <TextBlock Text="Write creates tags. Preview reports candidates without changing the model."
                   Foreground="#555555" TextWrapping="Wrap" Margin="0,0,0,18"/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Landing length (paper inches)"/>
                <TextBox x:Name="landingText"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Diagonal offset (paper inches)"/>
                <TextBox x:Name="offsetText"/>
            </StackPanel>
        </Grid>

        <TextBlock Margin="0,8,0,0" Foreground="#555555" TextWrapping="Wrap"
                   Text="Preferred lengths. Individual tags may use 75%-200%. Nearby tags can stack in aligned columns with extra vertical spacing."/>

        <TextBlock x:Name="errorText" Foreground="#AD2020" TextWrapping="Wrap"
                   MinHeight="20" Margin="0,14,0,10"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" IsCancel="True" Click="CancelClick" Margin="0,0,10,0"/>
            <Button x:Name="runButton" Content="Run" IsDefault="True" Click="RunClick"/>
        </StackPanel>
    </StackPanel>
</Window>
